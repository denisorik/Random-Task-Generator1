import tkinter as tk
from tkinter import messagebox, ttk
import random
import json
import os

# Имя файла для сохранения истории
HISTORY_FILE = "task_history.json"

class TaskGenerator:
    def __init__(self, root):
        self.root = root
        self.root.title("Random Task Generator")
        self.root.geometry("600x500")
        self.root.resizable(False, False)

        # Предопределённые задачи (категория: задача)
        self.default_tasks = [
            ("Прочитать статью по Python", "Учёба"),
            ("Посмотреть лекцию по алгоритмам", "Учёба"),
            ("Решить 3 задачи на LeetCode", "Учёба"),
            ("Сделать зарядку 15 минут", "Спорт"),
            ("Пробежка 2 км", "Спорт"),
            ("Планка 3 подхода", "Спорт"),
            ("Отправить отчёт на работе", "Работа"),
            ("Провести созвон с командой", "Работа"),
            ("Написать пост в блог", "Работа")
        ]
        
        # Загружаем историю
        self.history = self.load_history()
        # Текущий список задач (всегда содержит все задачи + добавленные пользователем)
        self.all_tasks = self.load_all_tasks()
        
        self.current_filter = "Все"
        self.create_widgets()
        self.update_task_list()
    
    def create_widgets(self):
        # Заголовок
        title = tk.Label(self.root, text="Генератор случайных задач", font=("Arial", 18, "bold"))
        title.pack(pady=10)
        
        # === Блок генерации ===
        frame_gen = tk.Frame(self.root)
        frame_gen.pack(pady=10)
        
        self.generate_btn = tk.Button(frame_gen, text="Сгенерировать задачу", command=self.generate_task,
                                      bg="#4CAF50", fg="white", font=("Arial", 12), padx=20, pady=5)
        self.generate_btn.pack()
        
        self.result_label = tk.Label(self.root, text="Нажмите кнопку, чтобы получить задачу", 
                                     font=("Arial", 12), fg="blue", wraplength=500)
        self.result_label.pack(pady=10)
        
        # === Фильтр ===
        filter_frame = tk.Frame(self.root)
        filter_frame.pack(pady=5)
        
        tk.Label(filter_frame, text="Фильтр по категории:", font=("Arial", 10)).pack(side=tk.LEFT, padx=5)
        self.filter_var = tk.StringVar(value="Все")
        self.filter_menu = ttk.Combobox(filter_frame, textvariable=self.filter_var, 
                                        values=["Все", "Учёба", "Спорт", "Работа"], state="readonly")
        self.filter_menu.pack(side=tk.LEFT, padx=5)
        self.filter_menu.bind("<<ComboboxSelected>>", lambda e: self.update_task_list())
        
        # === Редактирование задач ===
        edit_frame = tk.LabelFrame(self.root, text="Добавить новую задачу", padx=10, pady=10)
        edit_frame.pack(pady=10, fill="x", padx=20)
        
        tk.Label(edit_frame, text="Название:").grid(row=0, column=0, sticky="w")
        self.new_task_entry = tk.Entry(edit_frame, width=40)
        self.new_task_entry.grid(row=0, column=1, padx=5)
        
        tk.Label(edit_frame, text="Категория:").grid(row=1, column=0, sticky="w")
        self.new_category_var = tk.StringVar(value="Учёба")
        self.category_menu = ttk.Combobox(edit_frame, textvariable=self.new_category_var,
                                          values=["Учёба", "Спорт", "Работа"], state="readonly")
        self.category_menu.grid(row=1, column=1, padx=5, pady=5)
        
        add_btn = tk.Button(edit_frame, text="Добавить задачу", command=self.add_task,
                            bg="#2196F3", fg="white")
        add_btn.grid(row=2, column=0, columnspan=2, pady=5)
        
        # === Список всех задач ===
        list_frame = tk.LabelFrame(self.root, text="Все доступные задачи", padx=10, pady=10)
        list_frame.pack(fill="both", expand=True, padx=20, pady=10)
        
        self.tasks_listbox = tk.Listbox(list_frame, height=10, font=("Arial", 10))
        self.tasks_listbox.pack(side=tk.LEFT, fill="both", expand=True)
        
        scrollbar = tk.Scrollbar(list_frame, orient="vertical", command=self.tasks_listbox.yview)
        scrollbar.pack(side=tk.RIGHT, fill="y")
        self.tasks_listbox.config(yscrollcommand=scrollbar.set)
        
        # === История ===
        history_frame = tk.LabelFrame(self.root, text="История сгенерированных задач", padx=10, pady=10)
        history_frame.pack(fill="both", expand=True, padx=20, pady=10)
        
        self.history_listbox = tk.Listbox(history_frame, height=5, font=("Arial", 9))
        self.history_listbox.pack(side=tk.LEFT, fill="both", expand=True)
        
        history_scroll = tk.Scrollbar(history_frame, orient="vertical", command=self.history_listbox.yview)
        history_scroll.pack(side=tk.RIGHT, fill="y")
        self.history_listbox.config(yscrollcommand=history_scroll.set)
        
        # Кнопка очистки истории
        clear_history_btn = tk.Button(self.root, text="Очистить историю", command=self.clear_history,
                                      bg="#F44336", fg="white")
        clear_history_btn.pack(pady=5)
    
    def load_all_tasks(self):
        """Загружает все задачи: предопределённые + из истории (чтобы помнить добавленные)"""
        tasks = [list(task) for task in self.default_tasks]
        # Добавляем задачи из истории, которых ещё нет (чтобы не дублировать)
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    saved_tasks = data.get("all_tasks", [])
                    if isinstance(saved_tasks, list):
                        for task in saved_tasks:
                            if task not in tasks:
                                tasks.append(task)
            except:
                pass
        return tasks
    
    def save_all_tasks(self):
        """Сохраняет список всех задач в JSON (чтобы не терять добавленные)"""
        data = {
            "history": self.history,
            "all_tasks": self.all_tasks
        }
        try:
            with open(HISTORY_FILE, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except:
            pass
    
    def load_history(self):
        """Загружает историю и список задач из JSON"""
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    history = data.get("history", [])
                    # Обратная совместимость: если all_tasks нет, используем default
                    return history
            except:
                return []
        return []
    
    def save_history(self):
        """Сохраняет историю и список всех задач в JSON"""
        data = {
            "history": self.history,
            "all_tasks": self.all_tasks
        }
        try:
            with open(HISTORY_FILE, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
        except:
            pass
    
    def update_task_list(self):
        """Обновляет отображение списка задач в соответствии с фильтром"""
        self.tasks_listbox.delete(0, tk.END)
        category = self.filter_var.get()
        for task, cat in self.all_tasks:
            if category == "Все" or cat == category:
                self.tasks_listbox.insert(tk.END, f"[{cat}] {task}")
    
    def update_history_list(self):
        """Обновляет отображение истории"""
        self.history_listbox.delete(0, tk.END)
        for entry in self.history:
            self.history_listbox.insert(tk.END, entry)
    
    def generate_task(self):
        """Генерирует случайную задачу с учётом фильтра"""
        category = self.filter_var.get()
        available_tasks = []
        for task, cat in self.all_tasks:
            if category == "Все" or cat == category:
                available_tasks.append((task, cat))
        
        if not available_tasks:
            messagebox.showwarning("Нет задач", f"Нет задач в категории '{category}'\nДобавьте новые задачи!")
            return
        
        selected_task, selected_cat = random.choice(available_tasks)
        self.result_label.config(text=f"✅ Ваша задача:\n{selected_task} (Категория: {selected_cat})")
        
        # Добавляем в историю
        history_entry = f"{selected_task} [{selected_cat}]"
        self.history.append(history_entry)
        self.update_history_list()
        self.save_history()
    
    def add_task(self):
        """Добавляет новую задачу с проверкой на пустую строку"""
        task_name = self.new_task_entry.get().strip()
        category = self.new_category_var.get()
        
        if not task_name:
            messagebox.showerror("Ошибка", "Название задачи не может быть пустым!")
            return
        
        # Проверка на дубликат
        if [task_name, category] in self.all_tasks:
            messagebox.showinfo("Информация", "Такая задача уже существует!")
            return
        
        self.all_tasks.append([task_name, category])
        self.save_all_tasks()
        self.update_task_list()
        self.new_task_entry.delete(0, tk.END)
        messagebox.showinfo("Успех", f"Задача '{task_name}' добавлена в категорию '{category}'")
    
    def clear_history(self):
        """Очищает историю"""
        if messagebox.askyesno("Подтверждение", "Очистить всю историю?"):
            self.history = []
            self.update_history_list()
            self.save_history()
            self.result_label.config(text="История очищена")
    
    def on_closing(self):
        """При закрытии окна сохраняем данные"""
        self.save_all_tasks()
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = TaskGenerator(root)
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    root.mainloop()
